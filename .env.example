# Copy to .env for local (non-Docker) runs. docker-compose sets these itself.

# PostgreSQL DSN (system of record)
DATABASE_URL=postgresql+psycopg2://credit:credit@localhost:5433/credit_risk

# MLflow tracking server. Leave empty to disable tracking gracefully.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=credit-risk-inference

# Local Ollama LLM explainer. Leave empty to disable (UI then shows only the
# deterministic reason codes). Pull the model first: `ollama pull llama3.2:3b`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Point the test suite at an existing Postgres instead of testcontainers:
# TEST_DATABASE_URL=postgresql+psycopg2://credit:credit@localhost:5433/credit_risk_test
